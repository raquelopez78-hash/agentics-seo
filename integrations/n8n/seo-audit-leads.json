    {
      "parameters": {
        "jsCode": "// Cambia este valor por el mismo que pongas en SEO_LEADS_WEBHOOK_SECRET (Vercel).\nconst EXPECTED_SECRET = 'CAMBIA_ESTE_SECRETO';\n\nconst item = $input.first().json;\nconst secret = item.headers?.['x-webhook-secret'] ?? '';\nconst b = item.body ?? {};\nconst valid = secret === EXPECTED_SECRET && b.event === 'seo_audit.lead' && typeof b.email === 'string';\n\nreturn [{ json: {\n  valid,\n  fields: valid ? {\n    'ID': b.id,\n    'Fecha': b.createdAt,\n    'Nombre': b.name,\n    'Email': b.email,\n    'Empresa': b.company ?? '',\n    'URL auditada': b.auditedUrl,\n    'Puntuación': b.score,\n    'Nota': b.grade,\n    'Errores': b.fails,\n    'Mejoras': b.warnings,\n    'Problemas principales': (b.topIssues ?? []).map(i => `• ${i.label} (${i.category}): ${i.message}`).join('\\n'),\n    'Consentimiento marketing': !!b.marketing,\n  } : null,\n} }];"
      },
      "id": "a1f0c6d2-0002-4b6e-9a01-000000000002",
      "name": "Validar y mapear",
      "type": "n8n-nodes-base.code",
