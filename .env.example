# Copia a .env.local para desarrollo. En Vercel: Settings → Environment Variables.
SITE_URL=https://auditoria.agenticsprojects.com
# IA (checks cualitativos). Sin clave, la auditoría funciona y esos checks salen como "Requiere IA".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Core Web Vitals (opcional, sube la cuota de PageSpeed Insights)
PAGESPEED_API_KEY=
# Leads: se guardan en Postgres si hay DATABASE_URL y/o se envían al webhook (n8n). Al menos uno es obligatorio.
DATABASE_URL=
SEO_LEADS_WEBHOOK_URL=
SEO_LEADS_WEBHOOK_SECRET=
# Plan gratuito: informes completos por email (por defecto 2)
FREE_AUDITS_PER_EMAIL=2
# Emails con acceso Pro provisional (separados por comas)
SEO_PRO_EMAILS=
# Plan Pro (pago con Stripe + acceso por enlace al email)
PRO_PRICE_MONTHLY_EUR=39
PRO_PRICE_YEARLY_EUR=390
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cadena aleatoria larga para firmar la sesión (openssl rand -base64 48)
SESSION_SECRET=
# Envío del enlace de acceso (Gmail: contraseña de aplicación)
SMTP_USER=
SMTP_PASS=
# Enlace de reseñas de Google (se muestra tras desbloquear el informe)
NEXT_PUBLIC_REVIEW_URL=
