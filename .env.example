# Copia a .env.local para desarrollo. En Vercel: Settings → Environment Variables.
SITE_URL=https://auditoria.agenticsprojects.com
# IA (checks cualitativos). Sin clave, la auditoría funciona y esos checks salen como "Requiere IA".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Core Web Vitals (opcional, sube la cuota de PageSpeed Insights)
PAGESPEED_API_KEY=
# Leads: se guardan en Postgres si hay DATABASE_URL y/o se envían al webhook (n8n). Al menos uno es obligatorio.
DATABASE_URL=
SEO_LEADS_WEBHOOK_URL=
SEO_LEADS_WEBHOOK_SECRET=
